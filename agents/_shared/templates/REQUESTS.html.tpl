<article data-ts-kind="requirements" data-ts-doc-id="{{DOC_ID}}" role="document">
<header data-ts-role="frontmatter">
<script type="application/json" id="ts-frontmatter">
{"document_type":"requirements","status":"draft","stage":1,"created":"{{CREATED_DATE}}","doc_id":"{{DOC_ID}}","source":"{{SOURCE}}","tag":"{{TAG}}","output_format":"html"}
</script>
<h1>Requirements: {{FEATURE_TITLE}}</h1>
</header>
<section data-ts-kind="problem"><h2>1. Problem Statement</h2>
<p>{{PROBLEM_STATEMENT}}</p></section>
<section data-ts-kind="fr"><h2>2. Functional Requirements</h2>
<div class="ts-requirement" data-ts-id="FR-1"><h3>FR-1: {{FR_1_TITLE}}</h3>
<p>{{FR_1_DESCRIPTION}}</p></div>
<div class="ts-requirement" data-ts-id="FR-2"><h3>FR-2: {{FR_2_TITLE}}</h3>
<p>{{FR_2_DESCRIPTION}}</p></div></section>
<section data-ts-kind="nfr"><h2>3. Non-Functional Requirements</h2>
<div class="ts-requirement" data-ts-id="NFR-1"><h3>NFR-1: {{NFR_1_TITLE}}</h3>
<p>{{NFR_1_DESCRIPTION}}</p></div></section>
<section data-ts-kind="scope"><h2>4. Scope</h2>
<h3>In Scope</h3>
<ul>
<li class="ts-scope-in">{{IN_SCOPE_ITEM_1}}</li>
<li class="ts-scope-in">{{IN_SCOPE_ITEM_2}}</li>
</ul>
<h3>Out of Scope</h3>
<ul>
<li class="ts-scope-out">{{OUT_OF_SCOPE_ITEM_1}}</li>
<li class="ts-scope-out">{{OUT_OF_SCOPE_ITEM_2}}</li>
</ul></section>
<section data-ts-kind="hr"><h2>5. Hidden Requirements</h2>
<div class="ts-hr" data-ts-id="HR-1"><h3>HR-1: {{HR_1_TITLE}}</h3>
<p>{{HR_1_DESCRIPTION}}</p></div></section>
<section data-ts-kind="risk"><h2>6. Risks</h2>
<table>
<thead><tr><th>ID</th><th>Item</th><th>Risk</th><th>Severity</th><th>Mitigation</th></tr></thead>
<tbody>
<tr class="ts-risk-h" data-ts-id="R-1"><td>R-1</td><td>{{RISK_1_ITEM}}</td><td>{{RISK_1_DESCRIPTION}}</td><td>{{RISK_1_SEVERITY}}</td><td>{{RISK_1_MITIGATION}}</td></tr>
</tbody></table></section>
<section data-ts-kind="ac"><h2>7. Acceptance Criteria</h2>
<ul>
<li class="ts-ac" data-ts-id="AC-1">[ ] AC-1: {{AC_1_DESCRIPTION}}</li>
<li class="ts-ac" data-ts-id="AC-2">[ ] AC-2: {{AC_2_DESCRIPTION}}</li>
</ul></section>
<footer data-ts-role="validation"><h2>8. Validation Checklist</h2>
<ul>
<li>[ ] Problem Statement — defined</li>
<li>[ ] Functional Requirements (FR-1 through FR-N) — defined</li>
<li>[ ] Non-Functional Requirements (NFR-1 through NFR-N) — defined</li>
<li>[ ] Scope (In / Out) — defined</li>
<li>[ ] Hidden Requirements (HR-1 through HR-N) — analyzed via STRIDE + elicitation</li>
<li>[ ] Risks (R-1 through R-N) with severity and mitigation — defined</li>
<li>[ ] Acceptance Criteria (AC-1 through AC-N) — testable checkboxes</li>
<li>[ ] User approval — pending</li>
</ul></footer>
</article>
