<article data-ts-kind="retrospective" data-ts-doc-id="{{DOC_ID}}" role="document">
<header data-ts-role="frontmatter">
<script type="application/json" id="ts-frontmatter">
{"document_type":"retrospective","status":"draft","stage":4,"created":"{{CREATED_DATE}}","doc_id":"{{DOC_ID}}","source":"PROGRESS.md","output_format":"html"}
</script>
<h1>Retrospective — {{FEATURE_TITLE}}</h1>
</header>
<section data-ts-kind="summary"><h2>Summary</h2>
<p>{{SUMMARY_DESCRIPTION}}</p></section>
<section data-ts-kind="went-well"><h2>What Went Well</h2>
<ul>
<li class="ts-went-well">{{WENT_WELL_1}}</li>
<li class="ts-went-well">{{WENT_WELL_2}}</li>
<li class="ts-went-well">{{WENT_WELL_3}}</li>
</ul></section>
<section data-ts-kind="improvement"><h2>What Could Be Improved</h2>
<ul>
<li class="ts-improvement">{{IMPROVEMENT_1}}</li>
<li class="ts-improvement">{{IMPROVEMENT_2}}</li>
</ul></section>
<section data-ts-kind="decision"><h2>Decisions Made</h2>
<table>
<thead><tr><th>Decision</th><th>Rationale</th><th>Alternatives Considered</th></tr></thead>
<tbody>
<tr class="ts-decision"><td>{{DECISION_1}}</td><td>{{DECISION_1_RATIONALE}}</td><td>{{DECISION_1_ALTERNATIVES}}</td></tr>
</tbody></table></section>
<section data-ts-kind="ac"><h2>Action Items</h2>
<table>
<thead><tr><th>Item</th><th>Owner</th><th>Due</th><th>Status</th></tr></thead>
<tbody>
<tr class="ts-action-item" data-ts-id="AC-1"><td>{{ACTION_ITEM_1}}</td><td>{{OWNER_1}}</td><td>{{DUE_DATE_1}}</td><td>pending</td></tr>
</tbody></table></section>
<section data-ts-kind="metric"><h2>Metrics</h2>
<table>
<thead><tr><th>Metric</th><th>Target</th><th>Actual</th><th>Status</th></tr></thead>
<tbody>
<tr class="ts-metric"><td>Phases completed</td><td>{{PHASES_TARGET}}</td><td>{{PHASES_ACTUAL}}</td><td>{{PHASES_STATUS}}</td></tr>
<tr class="ts-metric"><td>AC items passed</td><td>{{AC_TARGET}}</td><td>{{AC_ACTUAL}}</td><td>{{AC_STATUS}}</td></tr>
<tr class="ts-metric"><td>Tests passing</td><td>100%</td><td>{{TESTS_ACTUAL}}</td><td>{{TESTS_STATUS}}</td></tr>
<tr class="ts-metric"><td>Spec compliance</td><td>PASS</td><td>{{SPEC_STATUS}}</td><td>{{SPEC_VERDICT}}</td></tr>
</tbody></table></section>
<footer data-ts-kind="learning" data-ts-role="learnings"><h2>Learnings</h2>
<ul>
<li class="ts-learning">{{LEARNING_1}}</li>
<li class="ts-learning">{{LEARNING_2}}</li>
</ul></footer>
</article>
